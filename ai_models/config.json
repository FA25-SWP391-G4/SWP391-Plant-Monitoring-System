{
  "models": {
    "watering_prediction": {
      "path": "./ai_models/watering_prediction",
      "version": "1.0.0",
      "input_shape": [1, 7],
      "output_classes": 2,
      "description": "Neural network for predicting watering needs based on sensor data"
    },
    "disease_recognition": {
      "path": "./ai_models/disease_recognition",
      "version": "2.0.0",
      "backend": "onnxruntime-cpu",
      "pipeline": "Two-Stage CPU: u2netp (SOD) + MobileNetV3-Large",
      "primary_model": "mobilenet_v3_large_14class_320x320.onnx",
      "segmentation_model": "u2netp.onnx",
      "alternative_model": "resnet18_14class_320x320.onnx",
      "input_shape": [320, 320, 3],
      "output_classes": 14,
      "supported_species": ["Aloe", "Cactus", "Money Plant", "Snake Plant", "Spider Plant"],
      "port": 8000,
      "endpoint": "/diagnose",
      "description": "Two-stage edge CPU Computer Vision engine with leaf isolation and 14-class fine-grained disease diagnosis"
    }
  },
  "preprocessing": {
    "image": {
      "resize": [320, 320],
      "segmentation": "u2netp_leaf_isolation",
      "feathering": true,
      "format": "RGB"
    },
    "sensor": {
      "features": ["moisture", "temperature", "humidity", "light"],
      "window_size": 7,
      "normalize": true
    }
  },
  "inference": {
    "batch_size": 1,
    "confidence_threshold": 0.52,
    "normalized_entropy_threshold": 0.48,
    "backend": "cpu"
  }
}
